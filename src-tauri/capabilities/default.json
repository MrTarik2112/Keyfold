{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions Keyfold needs: title bar controls, clipboard writing, file dialogs and revealing the vault file. Reading the clipboard is deliberately not granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir"
  ]
}
